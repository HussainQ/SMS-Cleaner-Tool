# CleanSMS Secrets & Configuration Template
# -----------------------------------------------------------------------------
# AI Studio automatically injects sensitive secrets into .env at build/runtime
# via the Secrets panel in the AI Studio UI.
# NEVER commit the real .env file or production keys to version control.
# 
# The variables below are populated with safe test/mock fallbacks for local
# development, simulation, and CI testing.

# Google Drive Cloud Backup OAuth Client ID (for Drive API integration)
GOOGLE_DRIVE_CLIENT_ID=test-cleansms-drive.apps.googleusercontent.com

# Dropbox Cloud Backup API Key / Token
DROPBOX_API_KEY=mock_test_dropbox_key_cleansms_2026

# Cloud Sync Service Endpoint
CLOUD_BACKUP_ENDPOINT=https://api.cleansms-backup-test.internal/v1
